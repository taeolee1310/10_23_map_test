{
  "name": "tangbang-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 execute tangbang --local --file schema.sql",
    "db:remote": "wrangler d1 execute tangbang --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
