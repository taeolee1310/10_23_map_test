# 이 파일을 복사해서 .env 로 만들고 값을 직접 채운다. (.env는 git에 올리지 않는다)
# REST 키: 파이썬에서만 사용. HTML·화면에 넣지 않는다.
KAKAO_REST_API_KEY=
# JavaScript 키: 지도 그릴 때 사용. 카카오 콘솔에 등록한 주소에서만 켜진다.
KAKAO_JS_KEY=
# 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 전국주차장정보표준데이터 API용. 파이썬에서만 사용.
DATA_GO_KR_API_KEY=
# 서울 열린데이터광장(data.seoul.go.kr) 인증키. 서울시 개인서비스 요금 정보(OA-1169)용. 파이썬에서만 사용.
SEOUL_OPEN_API_KEY=
# 요금 제보를 구글 시트에 쌓는 Vercel 서버 기능(web/api/report.js)에서만 사용. 화면에 넣지 않는다. 설정 순서는 docs/report-setup.md.
REPORT_SHEET_URL=
REPORT_SHEET_SECRET=
